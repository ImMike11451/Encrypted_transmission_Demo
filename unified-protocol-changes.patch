+	int keyId = 0,
+	const std::string& data = "")
+{
+	V2KeyOperationResponseInfo info;
+	info.header = buildKeyResponseHeader(packet, serverId, command);
+	info.code = code;
+	info.message = message;
+	info.keyId = keyId;
+	info.data = data;
+	return info;
+}
